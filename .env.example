# ──────────────────────────────────────────────────────────────
# COSMOS KIDS — Environment Variables
# ──────────────────────────────────────────────────────────────
# Copy this file to .env and fill in the values.
# NEVER commit .env to git.
#
# No VITE_ prefix on secrets — they stay server-side only.
# ──────────────────────────────────────────────────────────────

# --- LLM Provider (Mistral) ---
# Required for Nova assistant. Get a key at https://console.mistral.ai/
MISTRAL_API_KEY=

# --- Nova Configuration (all optional — defaults shown) ---
# Main model for verification (needs reasoning)
# NOVA_MODEL=mistral-large-latest

# Model for drafting responses (should NOT use thinking mode for speed)
# NOVA_DRAFT_MODEL=mistral-small-latest

# Faster model for classification (domain guard)
# NOVA_CLASSIFICATION_MODEL=mistral-small-latest

# Max questions per IP per hour
# NOVA_MAX_QUESTIONS_PER_HOUR=20

# Timeout per individual LLM API call (ms). Default 60s.
# The total pipeline makes up to 4 calls (classify + draft + verify + assemble).
# NOVA_TIMEOUT_MS=60000

# --- Web Search (optional) ---
# Brave Search API key for web source enrichment.
# If not set, Nova relies on catalog data only. Get a key at https://brave.com/search/api/
# BRAVE_SEARCH_API_KEY=

# Max conversation history messages sent to the LLM
# NOVA_MAX_HISTORY_MESSAGES=6

# CORS origin (defaults to request origin in dev)
# NOVA_CORS_ORIGIN=https://your-domain.com

# --- Standalone Node server (server/index.ts) ---
# NOVA_PORT=3001
# NOVA_HOST=127.0.0.1

# --- Mock mode (client-side, for development) ---
# Set to 1 to bypass the real API and use canned responses
# VITE_NOVA_MOCK=1
